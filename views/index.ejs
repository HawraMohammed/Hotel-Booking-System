<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="stylesheet" href="/stylesheets/style.css" />
  <link rel="stylesheet" href="/stylesheets/partials.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">

  <title>Home Page</title>
</head>

<body>
  <%- include('./partials/_navbar.ejs') %>

    <section id="hero">
      <div class="hero-content">

        <% if (user) { %>

          <% if (user.role==="admin" ) { %>

            <h1>Welcome back, <%= user.username %>!</h1>
            <p>Manage your hotels and keep your listings up to date.</p>

            <a href="/admin/hotels" class="hero-button">Manage Hotels</a>

            <% } else { %>

              <h1>Welcome back, <%= user.username %>!</h1>
              <p>Find the perfect place to stay for your next journey.</p>

              <a href="/hotels" class="hero-button">View Hotels</a>

              <% } %>

                <% } else { %>

                  <h1>Find Your Perfect Stay</h1>
                  <p>Discover beautiful hotels and book your stay with ease.</p>

                  <div class="hero-buttons">
                    <a href="/hotels" class="hero-button">View Hotels</a>
                    <a href="/auth/sign-up" class="hero-button">Sign Up</a>
                  </div>

                  <% } %>

      </div>
    </section>
    <script>
      const hero = document.querySelector("#hero");

      const images = [
        "/images/main.jpg",
        "/images/fort.jpg",
        "/images/mousqe.jpg",
        "/images/bridge.jpg",
        "/images/bh.jpg",
      ];

      let index = 0;

      hero.style.backgroundImage = `url(${images[index]})`;

      setInterval(() => {
        index = (index + 1) % images.length;
        hero.style.backgroundImage = `url(${images[index]})`;
      }, 5000);
    </script>

    <%- include('./partials/_footer.ejs') %>
</body>

</html>