<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hotels</title>
    <link rel="stylesheet" href="/stylesheets/style.css">
</head>

<body>
    <%- include('../partials/_navbar') %>
        <%if (hotels){%>
            <h1>All hotels</h1>
            <% hotels.forEach((hotel)=>{%>
                <div class="hotel-container">
                    <div class="pict-details">
                        <%if(hotel.pictures.length>0){%>
                            <div class="picture"><img src="<%=hotel.pictures[0].url%>"></div>
                            <%}%>
                                <div class="details">
                                    <h2>
                                        <%=hotel.name%>
                                    </h2>
                                    <p>
                                        <%=hotel.location%>
                                    </p>
                                    <p>
                                        <%=hotel.description%>
                                    </p>
                                </div>
                                <div class="buttons">
                                    <a href="/admin/hotels/<%=hotel._id%>">View</a>
                                    <a href="/admin/hotels/<%=hotel._id%>/edit">Edit</a>
                                    <form action="/admin/hotels/<%=hotel._id%>?_method=delete" method="post">
                                        <button type="submit">Delete</button>
                                    </form>

                                </div>
                    </div>
                    <div class="services">
                        <%hotel.services.forEach((service)=>{%>
                            <div class="service">
                                <p>
                                    <%=service%>
                                </p>
                            </div>
                            <%})%>
                    </div>
                    <div class="rooms">
                        <%hotel.rooms.forEach((room)=>{%>
                            <div class="room">
                                <p>
                                    <%=room.type%>
                                        <%=room.pricePerNight%>
                                </p>
                            </div>
                            <%})%>
                    </div>

                </div>
                <% }) } else {%>
                    <p>No hotels are added yet</p>
                    <%}%>
                        <a href="/admin/hotels/new">Add new hotel</a>
                        <%- include('../partials/_footer') %>
</body>

</html>