<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/stylesheets/reservation.css" />
    <link rel="stylesheet" href="/stylesheets/hotel.css" />
    <link rel="stylesheet" href="/stylesheets/style.css" />
    <link rel="stylesheet" href="/stylesheets/partials.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">

    <title>
        <%=hotel.name%>
    </title>
</head>

<body>
    <%- include('../partials/_navbar') %>
        <% const serviceIcons={ "Wifi" : "fa-solid fa-wifi" , "Swimming Pool" : "fa-solid fa-person-swimming"
            , "Room Service" : "fa-solid fa-bell-concierge" , "View" : "fa-solid fa-mountain-sun" , "Gym"
            : "fa-solid fa-dumbbell" , "Spa" : "fa-solid fa-spa" , "Parking" : "fa-solid fa-square-parking"
            , "Non-smoking rooms" : "fa-solid fa-ban-smoking" }; const roomIcons={ "Single" : "fa-solid fa-bed"
            , "Double" : "fa-solid fa-bed-pulse" , "Suite" : "fa-solid fa-hotel" }; %>
            <div class="show-hotel">

                <!-- HOTEL MAIN SECTION -->
                <div class="show-hotel-main">

                    <!-- GALLERY -->
                    <div class="gallery">

                        <div class="mainImage-container">

                            <button type="button" onclick="previousImage()" class="gallery-button">
                                ❮
                            </button>

                            <div class="main-image">
                                <img src="<%= hotel.pictures[0].url %>" alt="<%= hotel.name %>">
                            </div>

                            <button type="button" onclick="nextImage()" class="gallery-button">
                                ❯
                            </button>

                        </div>


                        <!-- THUMBNAILS -->
                        <div class="thumbnail">

                            <% hotel.pictures.forEach(picture=> { %>

                                <div class="thumbnail-picture">
                                    <img src="<%= picture.url %>" alt="<%= hotel.name %>">
                                </div>

                                <% }) %>

                        </div>

                    </div>


                    <!-- HOTEL DETAILS -->
                    <div class="show-hotel-details">

                        <h1>
                            <%= hotel.name %>
                        </h1>

                        <p class="show-location">
                            <i class="fa-solid fa-location-dot"></i>
                            <%= hotel.location %>
                        </p>

                        <p class="show-description">
                            <%= hotel.description %>
                        </p>

                        <div class="hotel-buttons">
                            <a href="/admin/hotels/<%= hotel._id %>/edit" class="view-button">
                                Edit
                            </a>

                            <form action="/admin/hotels/<%= hotel._id %>?_method=delete" method="post"
                                class="delete-form">
                                <button type="submit" class="delete-button">
                                    Delete
                                </button>

                            </form>
                        </div>

                    </div>

                </div>



                <!-- MAP -->
                <div class="hotel-map">

                    <h2>
                        <i class="fa-solid fa-location-dot"></i>
                        Location
                    </h2>

                    <div id="map"></div>

                    <input type="hidden" name="latitude" id="latitude" value="<%= hotel.map.latitude %>">

                    <input type="hidden" name="longitude" id="longitude" value="<%= hotel.map.longitude %>">

                </div>



                <!-- SERVICES AND ROOMS -->
                <div class="show-hotel-info">


                    <!-- SERVICES -->
                    <div class="show-services">

                        <h2>
                            Services & Amenities
                        </h2>

                        <div class="service-list">

                            <% hotel.services.forEach((service)=> { %>

                                <div class="service">

                                    <i class="<%= serviceIcons[service] %>"></i>

                                    <span>
                                        <%= service %>
                                    </span>

                                </div>

                                <% }) %>

                        </div>

                    </div>



                    <!-- ROOMS -->
                    <div class="show-rooms">

                        <h2>
                            Available Rooms
                        </h2>

                        <% hotel.rooms.forEach((room)=> { %>

                            <div class="room">

                                <div class="room-name">

                                    <i class="<%= roomIcons[room.type] %>"></i>

                                    <span>
                                        <%= room.type %>
                                    </span>
                                    <strong>
                                        <%= room.pricePerNight %> BHD
                                    </strong>
                                    <small class="room">/night</small>
                                </div>

                            </div>

                            <% }) %>

                    </div>

                </div>

            </div>



            <!-- COMMENTS -->
            <section class="comments-section">

                <h2>
                    Guest Reviews
                </h2>



                <div class="comments-list">

                    <% comments.forEach((comment)=> { %>

                        <div class="comment-container">
                            <img src="/images/profile.png" alt="Profile" class="comment-profile-picture">

                            <div class="comment">
                                <div class="comment-user-name">
                                    <%= comment.user ? comment.user.username : "Unknown User" %>
                                </div>
                                <div class="stars">

                                    <% for (let i=1; i <=5; i++) { %>

                                        <% if (i <=Number(comment.stars)) { %>

                                            <span class="star filled">★</span>

                                            <% } else { %>

                                                <span class="star">★</span>

                                                <% } %>

                                                    <% } %>

                                </div>

                                <h3>
                                    <%= comment.title %>
                                </h3>

                                <p>
                                    <%= comment.description %>
                                </p>

                            </div>

                        </div>

                        <% }) %>

                </div>


            </section>

            <script>  let map;
                let marker;

                function initMap() {

                    const initialLocation = {
                        lat: Number(document.getElementById("latitude").value),
                        lng: Number(document.getElementById("longitude").value)
                    };

                    map = new google.maps.Map(document.getElementById("map"), {
                        center: initialLocation,
                        zoom: 12
                    });

                    marker = new google.maps.Marker({
                        position: initialLocation,
                        map: map
                    });
                }
            </script>
            <script src="https://maps.googleapis.com/maps/api/js?key=<%= googleMapsApiKey %>&callback=initMap" async
                defer></script>

            <%- include('../partials/_footer') %>
                <script src="/js/imageGallery.js"></script>
</body>

</html>