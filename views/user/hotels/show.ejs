<!DOCTYPE html>
<html lang="en">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%=hotel.name%>
    </title>
    <link rel="stylesheet" href="/stylesheets/style.css">
</head>

<body>
    <%- include('../../partials/_navbar') %>
        <% const serviceIcons={ "Wifi" : "fa-solid fa-wifi" , "Swimming Pool" : "fa-solid fa-person-swimming"
            , "Room Service" : "fa-solid fa-bell-concierge" , "View" : "fa-solid fa-mountain-sun" , "Gym"
            : "fa-solid fa-dumbbell" , "Spa" : "fa-solid fa-spa" , "Parking" : "fa-solid fa-square-parking"
            , "Non-smoking rooms" : "fa-solid fa-ban-smoking" }; const roomIcons={ "Single" : "fa-solid fa-bed"
            , "Double" : "fa-solid fa-bed-pulse" , "Suite" : "fa-solid fa-hotel" }; %>
            <div class="hotel-container">
                <div class="pict-details">
                    <div class="gallery">
                        <div class="mainImage-container">
                            <button type="button" onclick="previousImage()">❮</button>
                            <div class="main-image"> <img src="<%= hotel.pictures[0].url %>"></div>
                            <button type="button" onclick="nextImage()">❯</button>
                        </div>
                        <div class="thumbnail">
                            <% hotel.pictures.forEach(picture=> { %>
                                <div class="picture">
                                    <img src="<%= picture.url %>">
                                </div>
                                <% }) %>
                        </div>
                    </div>
                    <div class="details">
                        <h2>
                            <%=hotel.name%>
                        </h2>
                        <p>
                            <%=hotel.location%>
                        </p>
                        <p>
                            <%=hotel.description%>
                        </p>
                    </div>
                    <div id="map"></div>

                    <input type="hidden" name="latitude" id="latitude" value="<%=hotel.map.latitude%>">
                    <input type="hidden" name="longitude" id="longitude" value="<%=hotel.map.longitude%>">
                    <div class="buttons">

                        <a href="/hotels/<%=hotel._id%>/reservations/new">Reserve now!!</a>

                    </div>
                </div>
                <div class="services">
                    <%hotel.services.forEach((service)=>{%>
                        <div class="service">
                            <span>
                                <i class="<%= serviceIcons[service] %>"></i>
                                <%= service %>
                            </span>
                        </div>
                        <%})%>
                </div>
                <div class="rooms">
                    <%hotel.rooms.forEach((room)=>{%>
                        <div class="room">
                            <span>
                                <i class="<%= roomIcons[room.type] %>"></i>
                                <%=room.type%>
                                    <%=room.pricePerNight%> BHD
                            </span>
                        </div>
                        <%})%>
                </div>

            </div>
            <%if(user){%>
                <form action="/hotels/<%=hotel._id%>/comments" method="post" class="comment">
                    <div class="rating">
                        <input type="hidden" name="rating" value="0">
                        <label>★</label>
                        <label>★</label>
                        <label>★</label>
                        <label>★</label>
                        <label>★</label>
                    </div>
                    <label for="title">Title</label>
                    <input type="text" name="title">
                    <label for="description">Description</label>
                    <textarea name="description"></textarea>
                    <button type="submit">Submit</button>
                </form>
                <%}%>
                    <% comments.forEach((comment)=>{%>
                        <div class="comment-container">
                            <div class="comment">
                                <div class="stars">
                                    <% for (let i=1; i <=5; i++) { %>
                                        <% if(i <=Number(comment.stars)){%> <label style="color:orange;">★</label>
                                            <%}else{%> <label style="color:grey;">★</label>
                                                <%} } %>
                                </div>
                                <h3>
                                    <%= comment.title %>
                                </h3>
                                <p>
                                    <%= comment.description %>
                                </p>
                                <% if (user && comment.user.equals(user._id)) { %> <button>Edit</button>
                                    <form action="/hotels/<%=hotel._id%>/comments/<%=comment._id%>?_method=delete"
                                        method="post">
                                        <button type="submit">Delete</button>
                                    </form>
                                    <%}%>
                            </div>
                            <form action="/hotels/<%=hotel._id%>/comments/<%=comment._id%>?_method=put" method="post"
                                class="comment" style="display: none;">
                                <div class="rating">
                                    <input type="hidden" name="rating" value="<%=comment.stars%>">
                                    <% for (let i=1; i <=5; i++) { %>
                                        <% if(i <=comment.stars){%> <label style="color:orange;">★</label>
                                            <%}else{%> <label style="color:grey;">★</label>
                                                <%} } %>
                                </div>
                                <label for="title">Title</label>
                                <input type="text" name="title" value="<%=comment.title%>">
                                <label for="description">Description</label>
                                <textarea name="description"><%=comment.description%></textarea>
                                <button type="submit">Save changes</button>
                            </form>
                        </div>
                        <% })%>
                            <%- include('../../partials/_footer') %>
                                <script>
                                    let map;
                                    let marker;

                                    function initMap() {

                                        const initialLocation = {
                                            lat: Number(document.getElementById("latitude").value),
                                            lng: Number(document.getElementById("longitude").value)
                                        };

                                        map = new google.maps.Map(document.getElementById("map"), {
                                            center: initialLocation,
                                            zoom: 12
                                        });

                                        marker = new google.maps.Marker({
                                            position: initialLocation,
                                            map: map
                                        });
                                    }
                                </script>
                                <script
                                    src="https://maps.googleapis.com/maps/api/js?key=AIzaSyAfdf1VYfjilSBehoOcOy5csWIOsQdOJME&callback=initMap"
                                    async defer></script>

                                <style>
                                    #map {
                                        width: 100%;
                                        height: 400px;
                                        border: 2px solid red;
                                    }
                                </style>
                                <script src="/js/imageGallery.js"></script>
                                <script src="/js/commentCtrl.js"></script>
</body>

</html>