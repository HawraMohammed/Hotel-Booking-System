<!DOCTYPE html>
<html lang="en">
<link rel="stylesheet" href="/stylesheets/partials.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%=hotel.name%>
    </title>
    <link rel="stylesheet" href="/stylesheets/hotel.css" />
    <link rel="stylesheet" href="/stylesheets/style.css">
</head>

<body>
    <%- include('../../partials/_navbar') %>
        <% const serviceIcons={ "Wifi" : "fa-solid fa-wifi" , "Swimming Pool" : "fa-solid fa-person-swimming"
            , "Room Service" : "fa-solid fa-bell-concierge" , "View" : "fa-solid fa-mountain-sun" , "Gym"
            : "fa-solid fa-dumbbell" , "Spa" : "fa-solid fa-spa" , "Parking" : "fa-solid fa-square-parking"
            , "Non-smoking rooms" : "fa-solid fa-ban-smoking" }; const roomIcons={ "Single" : "fa-solid fa-bed"
            , "Double" : "fa-solid fa-bed-pulse" , "Suite" : "fa-solid fa-hotel" }; %>
            <div class="show-hotel">

                <div class="show-hotel-main">

                    <div class="gallery">

                        <div class="mainImage-container">

                            <button type="button" onclick="previousImage()" class="gallery-button">
                                ❮
                            </button>

                            <div class="main-image">
                                <img src="<%= hotel.pictures[0].url %>" alt="<%= hotel.name %>">
                            </div>

                            <button type="button" onclick="nextImage()" class="gallery-button">
                                ❯
                            </button>

                        </div>


                        <div class="thumbnail">

                            <% hotel.pictures.forEach(picture=> { %>

                                <div class="thumbnail-picture">
                                    <img src="<%= picture.url %>" alt="<%= hotel.name %>">
                                </div>

                                <% }) %>

                        </div>

                    </div>


                    <div class="show-hotel-details">

                        <h1>
                            <%= hotel.name %>
                        </h1>

                        <p class="show-location">
                            <i class="fa-solid fa-location-dot"></i>
                            <%= hotel.location %>
                        </p>

                        <p class="show-description">
                            <%= hotel.description %>
                        </p>


                        <div class="hotel-buttons">

                            <a href="/hotels/<%= hotel._id %>/reservations/new" class="reserve-button">
                                Reserve Now
                            </a>

                        </div>

                    </div>

                </div>



                <div class="hotel-map">

                    <h2>
                        <i class="fa-solid fa-location-dot"></i>
                        Location
                    </h2>

                    <div id="map"></div>

                    <input type="hidden" name="latitude" id="latitude" value="<%= hotel.map.latitude %>">

                    <input type="hidden" name="longitude" id="longitude" value="<%= hotel.map.longitude %>">

                </div>



                <div class="show-hotel-info">


                    <div class="show-services">

                        <h2>
                            Services & Amenities
                        </h2>

                        <div class="service-list">

                            <% hotel.services.forEach((service)=> { %>

                                <div class="service">

                                    <i class="<%= serviceIcons[service] %>"></i>

                                    <span>
                                        <%= service %>
                                    </span>

                                </div>

                                <% }) %>

                        </div>

                    </div>



                    <div class="show-rooms">

                        <h2>
                            Available Rooms
                        </h2>

                        <% hotel.rooms.forEach((room)=> { %>

                            <div class="room">

                                <div class="room-name">

                                    <i class="<%= roomIcons[room.type] %>"></i>

                                    <span>
                                        <%= room.type %>
                                    </span>
                                    <strong>
                                        <%= room.pricePerNight %> BHD
                                    </strong>
                                    <small class="room">/night</small>
                                </div>



                            </div>

                            <% }) %>

                    </div>

                </div>

            </div>



            <section class="comments-section">

                <h2>
                    Guest Reviews
                </h2>


                <% if (user) { %>

                    <form action="/hotels/<%= hotel._id %>/comments" method="post" class="comment-form">

                        <h3>
                            Share your experience
                        </h3>


                        <div class="rating">

                            <input type="hidden" name="rating" value="0">

                            <label>★</label>
                            <label>★</label>
                            <label>★</label>
                            <label>★</label>
                            <label>★</label>

                        </div>


                        <label for="title">
                            Title
                        </label>

                        <input type="text" name="title" id="title" required>


                        <label for="description">
                            Description
                        </label>

                        <textarea name="description" id="description" required></textarea>


                        <button type="submit">
                            Submit Review
                        </button>

                    </form>

                    <% } %>



                        <div class="comments-list">

                            <% comments.forEach((comment)=> { %>
                                <div class="comment-container">
                                    <img src="/images/profile.png" alt="Profile" class="comment-profile-picture">

                                    <div class="comment">
                                        <div class="comment-user-name">
                                            <%= comment.user ? comment.user.username : "Unknown User" %>
                                        </div>
                                        <div class="stars">

                                            <% for (let i=1; i <=5; i++) { %>

                                                <% if (i <=Number(comment.stars)) { %>
                                                    <span class="star filled">★</span>
                                                    <% } else { %>
                                                        <span class="star">★</span>
                                                        <% } %>

                                                            <% } %>

                                        </div>


                                        <h3>
                                            <%= comment.user.username %>
                                        </h3>
                                        <h3>
                                            <%= comment.title %>
                                        </h3>

                                        <p>
                                            <%= comment.description %>
                                        </p>


                                        <% if (user && comment.user && comment.user.equals(user._id)) { %>

                                            <div class="comment-actions">

                                                <button type="button" class="edit-button">
                                                    Edit
                                                </button>

                                                <form
                                                    action="/hotels/<%= hotel._id %>/comments/<%= comment._id %>?_method=delete"
                                                    method="post">

                                                    <button type="submit">
                                                        Delete
                                                    </button>

                                                </form>

                                            </div>

                                            <% } %>

                                    </div>


                                    <% if (user && comment.user && comment.user.equals(user._id)) { %>

                                        <form action="/hotels/<%= hotel._id %>/comments/<%= comment._id %>?_method=put"
                                            method="post" class="comment-form edit-form" style="display: none;">

                                            <div class="rating">

                                                <input type="hidden" name="rating" value="<%= comment.stars %>">

                                                <% for (let i=1; i <=5; i++) { %>

                                                    <% if (i <=Number(comment.stars)) { %>

                                                        <label style="color: orange;">★</label>

                                                        <% } else { %>

                                                            <label style="color: gray;">★</label>

                                                            <% } %>

                                                                <% } %>

                                            </div>


                                            <label for="edit-title">
                                                Title
                                            </label>

                                            <input type="text" id="edit-title" name="title" value="<%= comment.title %>"
                                                required>


                                            <label for="edit-description">
                                                Description
                                            </label>

                                            <textarea id="edit-description" name="description"
                                                required><%= comment.description %></textarea>


                                            <button type="submit">
                                                Save Changes
                                            </button>

                                        </form>

                                        <% } %>

                                </div>
                                <% }) %>

                        </div>

            </section>



            <%- include('../../partials/_footer') %>

                <script>

                    let map;
                    let marker;


                    function initMap() {

                        const initialLocation = {

                            lat: Number(
                                document.getElementById("latitude").value
                            ),

                            lng: Number(
                                document.getElementById("longitude").value
                            )

                        };


                        map = new google.maps.Map(
                            document.getElementById("map"),
                            {
                                center: initialLocation,
                                zoom: 12
                            }
                        );


                        marker = new google.maps.Marker({

                            position: initialLocation,

                            map: map

                        });

                    }

                </script>


                <script src="https://maps.googleapis.com/maps/api/js?key=<%= googleMapsApiKey %>&callback=initMap" async
                    defer>
                    </script>
                <script src="/js/imageGallery.js"></script>
                <script src="/js/commentCtrl.js"></script>
</body>

</html>