<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%=hotel.name%>
    </title>
    <link rel="stylesheet" href="/stylesheets/style.css">
</head>

<body>
    <%- include('../../partials/_navbar') %>
        <div class="hotel-container">
            <div class="pict-details">
                <div class="picture"><img src="<%=hotel.picture%>"></div>
                <div class="details">
                    <h2>
                        <%=hotel.name%>
                    </h2>
                    <p>
                        <%=hotel.location%>
                    </p>
                    <p>
                        <%=hotel.description%>
                    </p>
                </div>
                <div class="buttons">

                    <a href="/hotels/<%=hotel._id%>/reservations/new">Reserve now!!</a>

                </div>
            </div>
            <div class="services">
                <%hotel.services.forEach((service)=>{%>
                    <div class="service">
                        <p>
                            <%=service%>
                        </p>
                    </div>
                    <%})%>
            </div>
            <div class="rooms">
                <%hotel.rooms.forEach((room)=>{%>
                    <div class="room">
                        <p>
                            <%=room.type%>
                                <%=room.pricePerNight%>
                        </p>
                    </div>
                    <%})%>
            </div>

        </div>
        <%- include('../../partials/_footer') %>
</body>

</html>