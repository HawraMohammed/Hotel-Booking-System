<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>new reservation</title>
</head>

<body>
    <%- include('../../partials/_navbar') %>
        <h2>Reservation at <%=hotel.name%>
        </h2>
        <form action="/hotels/<%=hotel._id%>/reservations" method="post">
            <div id="rooms-container">

                <div class="room">
                    <label>Room Type</label>
                    <select name="roomType">
                        <%hotel.rooms.forEach((room)=>{%>
                            <option value="<%=room.type%>" data-price="<%=room.pricePerNight%>"
                                data-guests="<%=room.capacity%>">
                                <%=room.type%>
                            </option>

                            <%})%>
                    </select>

                    <label for="pricePerNight">Price Per Night</label>
                    <input type="number" name="pricePerNight" readonly value="<%=hotel.rooms[0].pricePerNight%>">

                    <label for="numOfGuests">Number of guests</label>
                    <input type="number" name="numOfGuests" readonly value="<%=hotel.rooms[0].capacity%>">
                </div>
                <label for="checkIn">Check-in</label>
                <input type="date" name="checkIn">

                <label for="checkOut">Check-out</label>
                <input type="date" name="checkOut" disabled>

                <label for="total">Total</label>
                <input type="text" name="total" readonly>

                <label for="paymentMethod">Payment Method</label>
                <select name="paymentMethod">
                    <option value="Benefit Pay">Benefit Pay</option>
                    <option value="Cash">Cash</option>
                    <option value="Apple Pay">Apple Pay</option>
                    <option value="Credit Card">Credit Card</option>
                </select>
            </div>
            <button type="submit">Reserve</button>
        </form>
        <%- include('../../partials/_footer') %>
            <script src="/js/handleDates.js"></script>
</body>

</html>